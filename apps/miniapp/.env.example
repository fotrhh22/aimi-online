# Browser-visible values only. Never put server keys here.
# npm run dev supplies /api and proxies to the localhost prototype API.
# .ait builds use the actual HTTPS API URL; no local auth fallback outside localhost.
VITE_API_BASE_URL=https://aimi-online-api.onrender.com

# Set only by npm run ait:build:test, never by the regular production build.
VITE_TEST_DEMO=false
