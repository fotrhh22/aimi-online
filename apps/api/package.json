{
  "name": "@aimi/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server.js",
    "db:migrate": "node --import tsx src/migrate.ts",
    "test": "node --import tsx --test test/unit.test.ts",
    "test:db": "node --import tsx --test test/integration.test.ts",
    "db:provision": "node --import tsx src/provision-db.ts"
  },
  "dependencies": {
    "@aimi/contracts": "0.1.0",
    "@fastify/cors": "^11.0.0",
    "fastify": "^5.6.0",
    "pg": "^8.16.0",
    "dotenv": "^17.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.6.3"
  }
}
