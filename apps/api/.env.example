# API 기반 설정. AI·토스 부가 설정은 해당 기능 구현 시 연결.
# 실제 값은 .env.local 또는 Render 비밀 설정에만 저장. VITE_ 접두사 금지.
NODE_ENV=development
HOST=127.0.0.1
PORT=8080
LOG_LEVEL=info
ENABLE_DEV_AUTH=false

# Connect에서 복사. 런타임 역할과 migration 역할을 분리한다.
DATABASE_URL=
MIGRATION_DATABASE_URL=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SESSION_SIGNING_KEY=
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5180,http://localhost:5180

# 인증서 방식·필드는 토스 공식 연동 문서/콘솔 확인 후 확정.
# Render Secret Files 예: /etc/secrets/toss-client.crt, /etc/secrets/toss-client.key
TOSS_CLIENT_CERT_PATH=
TOSS_CLIENT_KEY_PATH=
TOSS_USERINFO_DECRYPTION_KEY=
TOSS_UNLINK_BASIC_AUTH=

# AI는 실제 계정의 모델·제한 정책 확정 후 설정. 빈 값으로 외부 호출하지 않는다.
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.1-flash-lite
OPTIMIZER_DAILY_LIMIT=
RECOMMENDATION_DAILY_LIMIT=
LLM_REQUEST_TIMEOUT_MS=
LLM_MAX_INPUT_CHARS=
LLM_MAX_OUTPUT_TOKENS=
LLM_MAX_RETRIES=
LLM_DAILY_BUDGET_USD=
PROMPT_RETENTION_HOURS=

# Gemini Free Tier 사용 계획. $200 크레딧을 가정하지 않음.
# 아래 설정을 읽거나 호출을 차단하는 코드는 아직 없음.
LLM_PAID_USAGE_ENABLED=false
LLM_MONTHLY_BUDGET_USD=
LLM_BUDGET_TIMEZONE=Asia/Seoul
LLM_BUDGET_ALERT_THRESHOLDS=0.5,0.8,0.95
LLM_MONTHLY_STOP_RATIO=0.95
GEMINI_BILLING_TIER=free
