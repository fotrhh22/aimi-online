# Server-only settings. Keep real values in .env.local / Render secret settings.
NODE_ENV=development
HOST=127.0.0.1
PORT=8080
LOG_LEVEL=info
ENABLE_DEV_AUTH=false
DATABASE_URL=
MIGRATION_DATABASE_URL=
SESSION_SIGNING_KEY=
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5180,http://localhost:5180

# Existing Supabase/Storage integration boundary; v1 sample assets are bundled locally.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Actual Toss mTLS integration; never expose these to VITE_.
TOSS_CLIENT_CERT_PATH=
TOSS_CLIENT_KEY_PATH=
# Anonymous code exchange also uses these existing server-only mTLS paths.
# Render Secret Files: /etc/secrets/AIMI_mTLS_public.crt and /etc/secrets/AIMI_mTLS_private.key
# TOSS_UNLINK_BASIC_AUTH below belongs to legacy Toss OAuth callbacks, not anonymous auth.
# Exact Authorization header configured in the POST unlink callback.
TOSS_UNLINK_BASIC_AUTH=

AIMI_GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.1-flash-lite
OPTIMIZER_DAILY_LIMIT=5
RECOMMENDATION_DAILY_LIMIT=5
LLM_REQUEST_TIMEOUT_MS=25000
LLM_MAX_OUTPUT_TOKENS=3000
# v1: input4000 chars, service100 requests/Seoul day,24h result retention.
# These bounds are not USD billing limits. Free-tier availability follows the provider account.

# npm run dev starts a localhost-only development API without DATABASE_URL.
# Default: reset EP/inventory/games/AI jobs and local sessions on every server restart.
AIMI_DEV_PERSIST_STATE=false
PROTOTYPE_PORT=8081
# fixture uses labeled deterministic responses only on the localhost prototype server.
# Leave empty to use the actual Gemini key, or show a labeled fixture if that key is absent locally.
AIMI_AI_MODE=

# production /v1 is blocked until release policy/content have been explicitly reviewed.
# Do not enable development economic fixtures as an unreviewed live service.
AIMI_RELEASE_VERSION=

# Explicit remote preview release; never implies visual approval.
AIMI_CONTENT_SOURCE=
AIMI_CONTENT_PREVIEW=false

# Explicit shared UI test namespace only; never enables /auth/dev.
ENABLE_TEST_DEMO=false
# Demo Gemini: fixed20 requests/rolling hour,48h from first test session; DB persists across resets.
