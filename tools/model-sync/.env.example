# 향후 수집 CLI/CI 전용. 아직 수집 실행 코드는 없음.
# 수집 작업은 API 서버 키·사용자 테이블 쓰기 권한을 공유하지 않는다.
# 선택한 데이터 API가 인증을 요구하는 경우에만 키를 설정한다.
ARTIFICIAL_ANALYSIS_API_KEY=
OPENROUTER_API_KEY=
MODEL_SYNC_DATABASE_URL=

# 공개 endpoint. AA Free 경로도 유효한 API 키가 필요하다.
OPENROUTER_MODELS_URL=https://openrouter.ai/api/v1/models
ARTIFICIAL_ANALYSIS_MODELS_URL=https://artificialanalysis.ai/api/v2/language/models/free
MODEL_SYNC_HTTP_TIMEOUT_MS=30000
MODEL_SYNC_MAX_RETRIES=2
MODEL_SYNC_MAX_PAGES=100
MODEL_SYNC_STALE_AFTER_HOURS=240
